{% from "_macros.html.j2" import num, chg, fx_table, change_table, curve_table, uzonia_table, repo_table, interbank_table, treasury_table, stocks_table, summary_band, cap_table with context %}
{% set cap = {} %}{% for t in (capital_tables or []) %}{% set _ = cap.update({t.slot: t}) %}{% endfor %}
{#-
  NBU "ОБЗОР РЫНКА" — two A3-landscape pages, pixel-matched to the Canva
  reference: exact fonts (Bebas/Lora/Noto Sans/Open Sans/Times→Tinos), exact
  point sizes, gold accent --accent-gold defined once.
-#}
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8"/>
<style>
{{ font_face_css|safe }}
:root {
  --accent-gold: {{ L.accent_gold }};
  --page-bg: {{ L.page_bg }};
  --gold-line: {{ L.gold_line }};
  --gold-text: {{ L.gold_text }};
  --card-bg: {{ L.card_bg }};
  --ink: {{ L.ink }};
  --grid: {{ L.grid }};
  --tbl-border: {{ L.table_border }};
  --pill-line: {{ L.pill_line }};
  --display-font: "{{ L.display_font }}","Oswald",sans-serif;
  --headline-font: "{{ L.headline_font }}",serif;
  --body-font: "{{ L.body_font }}",Arial,sans-serif;
  --table-font: "{{ L.table_font }}","Times New Roman",serif;
}
@page { size: A3 landscape; margin: 0; }
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: var(--body-font); color: var(--ink);
  -webkit-print-color-adjust: exact; print-color-adjust: exact;
}
.page {
  position: relative;
  width: 420mm; height: 297mm;
  background: var(--page-bg);
  overflow: hidden; page-break-after: always;
  padding: {{ L.page_padding_mm }}mm {{ L.page_padding_mm + 0.4 }}mm;
}
.page:last-child { page-break-after: auto; }
.bg-wm {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; opacity: {{ L.background_opacity }};
  filter: grayscale({{ L.background_grayscale }}); pointer-events: none; z-index: 0;
}
.page > *:not(.bg-wm) { position: relative; z-index: 1; }

/* ---------- Masthead ---------- */
.masthead {
  display: grid; grid-template-columns: 120px 1fr 250pt;
  align-items: center; height: 74pt; margin-bottom: 6pt;
}
.logo-badge {
  width: 70pt; height: 70pt; border-radius: 50%;
  background: #fffdf8; border: 2.2pt solid var(--gold-line);
  display: flex; align-items: center; justify-content: center;
}
.logo-badge img { height: 46pt; }
.cartouche {
  justify-self: center; text-align: center;
  background: #fffdf8; border: 2pt solid var(--gold-line);
  border-radius: 50%/50%; padding: 8pt 90pt 14pt; min-width: 340pt;
}
.cartouche h1 {
  margin: 0; font-family: var(--display-font);
  font-size: {{ L.title_size }}pt; line-height: 1; letter-spacing: 4pt; color: var(--ink);
}
.cartouche .date {
  font-family: var(--body-font); font-weight: 700; font-size: {{ L.date_size }}pt;
  letter-spacing: 1pt; color: var(--gold-text); margin-top: 3pt;
}
.dept {
  justify-self: end; align-self: start; white-space: nowrap;
  background: #fffdf8; border: 1.6pt solid var(--gold-line); border-radius: 9pt;
  font-family: var(--body-font); font-weight: 700; font-size: {{ L.dept_size }}pt; color: var(--ink);
  text-align: center; padding: 11pt 16pt; line-height: 1.05;
}

/* ---------- Page 1 quadrants ---------- */
.quad-grid {
  display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr;
  gap: {{ L.quad_gap }}pt; height: calc(297mm - {{ 2 * L.page_padding_mm }}mm - 74pt - 6pt); margin-top: 16pt;
}
.quad {
  position: relative; background: var(--card-bg);
  border: {{ L.card_border_w }}pt solid var(--gold-line); border-radius: 3pt;
  padding: {{ L.card_padding + 7 }}pt {{ L.card_padding }}pt 10pt;
}
.quad .pill {
  position: absolute; top: -19pt; left: 50%; transform: translateX(-50%);
  background: #fffdf8; border: 1.6pt solid var(--pill-line); border-radius: 13pt;
  font-family: var(--body-font); font-weight: 700; font-size: {{ L.pill_size }}pt; letter-spacing: 1.5pt;
  color: var(--ink); padding: 1pt 34pt; white-space: nowrap; line-height: 1.15;
}
.quad .body { font-size: {{ L.news_size }}pt; line-height: 1.3; text-align: justify; height: 100%; overflow: hidden; }
.quad .body p { margin: 0 0 5pt 0; }
.quad .body p.lead { font-family: var(--headline-font); font-weight: 700; margin-bottom: 4pt; }

/* ---------- Page 2 ---------- */
.col-head {
  text-align: center; font-family: var(--body-font); font-weight: 700; font-size: {{ L.col_head_size }}pt;
  letter-spacing: 1pt; color: var(--ink); padding-bottom: 4pt; margin-bottom: 6pt;
  border-bottom: 2pt solid var(--gold-line);
}
.section-band {
  color: var(--ink); text-align: center;
  font-family: var(--display-font); font-size: {{ L.section_head_size }}pt; letter-spacing: 1pt;
  padding: 1pt 0 0; margin: 4pt 0 3pt; line-height: 1.2;
}
.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 12pt; }
.subgrid { display: grid; grid-template-columns: 1fr 1fr; gap: {{ L.table_gap }}pt; align-items: start; }

table.tbl {
  width: 100%; border-collapse: collapse; font-family: var(--table-font);
  font-size: {{ L.table_size }}pt; background: #fff; margin-bottom: 5pt; border: {{ L.table_border_w }}pt solid var(--tbl-border);
}
table.tbl caption {
  background: var(--accent-gold); color: var(--ink); font-family: var(--headline-font); font-weight: 700;
  font-size: {{ L.caption_size }}pt; padding: 2pt; border: {{ L.table_border_w }}pt solid var(--tbl-border); border-bottom: 0;
}
table.tbl th, table.tbl td { border: 0.8pt solid var(--grid); padding: 1.2pt 4pt; text-align: right; white-space: nowrap; }
table.tbl th { background: var(--accent-gold); color: var(--ink); font-weight: 400; text-align: center; }
table.tbl td.lbl { text-align: left; font-weight: 700; }
table.tbl th.lbl { text-align: left; }
tr.flagged td { background: #fff3c4 !important; }

.charts-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10pt; margin: 6pt 0; }
.chart-card { background: #fff; border: 1pt solid var(--tbl-border); padding: 4pt; }
.chart-card img { width: 100%; height: auto; display: block; }
.chart-card .cap { font-family: var(--body-font); font-size: 8pt; color: #222; text-align: center; padding-top: 2pt; }

.summary-band { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5pt; margin: 6pt 0; }
.summary-band .cell { background: var(--accent-gold); color: var(--ink); padding: 5pt 4pt; text-align: center; border: 1pt solid var(--tbl-border); }
.summary-band .cell .k { font-family: var(--body-font); font-size: 7.6pt; line-height: 1.12; display: block; }
.summary-band .cell .v { font-family:"Montserrat",var(--body-font); font-weight: 700; font-size: {{ L.summary_value_size }}pt; }

.capnews { font-family: var(--body-font); font-size: 9pt; line-height: 1.3; text-align: justify; }
.capnews h4 { margin: 4pt 0 3pt; font-family: var(--display-font); font-size: 14pt; letter-spacing:.5pt; text-align: center; padding: 1pt; }
.foot-note { font-family:"OpenSansIt"; font-style: italic; font-size: {{ L.footnote_size }}pt; color: var(--ink); margin-top: 5pt; }
</style>
</head>
<body>

{% set show_wm = L.background_placement == 'watermark' and background_uri %}
{# ===================== PAGE 1 — NEWS ===================== #}
<section class="page">
  {% if show_wm %}<img class="bg-wm" src="{{ background_uri }}"/>{% endif %}
  <header class="masthead">
    <div class="logo-badge">{% if logo_uri %}<img src="{{ logo_uri }}"/>{% endif %}</div>
    <div class="cartouche">
      <h1>{{ meta.title }}</h1>
      <div class="date">{{ meta.weekday }} {{ meta.issue_date }}</div>
    </div>
    <div class="dept">{{ meta.department }}</div>
  </header>

  <div class="quad-grid">
    {% for key, label in [('us','США'), ('europe','ЕВРОПА'), ('asia','АЗИЯ'), ('cis','СНГ')] %}
    <div class="quad">
      <div class="pill">{{ label }}</div>
      <div class="body">
        {% for para in (news[key] or '').split('\n') if para.strip() %}
        <p class="{{ 'lead' if loop.first }}">{{ para }}</p>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>

{# ===================== PAGE 2 — DATA ===================== #}
<section class="page">
  {% if show_wm %}<img class="bg-wm" src="{{ background_uri }}"/>{% endif %}
  <div class="two-col">
    {# -------- LEFT: LOCAL MARKET -------- #}
    <div>
      <div class="col-head">ЛОКАЛЬНЫЙ РЫНОК</div>
      <div class="section-band">ДЕНЕЖНЫЙ РЫНОК</div>
      <div class="subgrid">
        {{ fx_table(cbu_fx, 'КУРСЫ ВАЛЮТ', 'Курс') if cbu_fx }}
        {{ uzonia_table(money_market.uzonia) if money_market }}
      </div>
      <div class="subgrid">
        {{ interbank_table(money_market.interbank) if money_market }}
        {{ repo_table(money_market.repo) if money_market }}
      </div>
      {% if money_market %}{{ summary_band(money_market.summary) }}{% endif %}
      {% if L.show_charts %}
      <div class="charts-row">
        <div class="chart-card"><img src="{{ charts.system_liquidity }}"/><div class="cap">Общая ликвидность (итог корр. счетов в ЦБ)</div></div>
        <div class="chart-card"><img src="{{ charts.cb_operations }}"/><div class="cap">Операции ЦБ по привлечению ликвидности</div></div>
      </div>
      {% endif %}
      <div class="section-band">РЫНОК КАПИТАЛА</div>
      <div class="subgrid">
        <div>
          {{ cap_table(cap.corp_bonds) }}
          {{ stocks_table(stocks) if stocks }}
          {% if L.show_footnote %}<div class="foot-note">*TSMI - Tashkent Stock Market Index</div>{% endif %}
        </div>
        <div>
          {{ cap_table(cap.gov_bonds) }}
          {% if L.show_capital_news and news.capital_markets %}
          <div class="capnews">
            <h4>НОВОСТИ РЫНКА КАПИТАЛА</h4>
            {% for item in news.capital_markets %}<p>{{ item }}</p>{% endfor %}
          </div>
          {% endif %}
        </div>
      </div>
    </div>

    {# -------- RIGHT: INTERNATIONAL MARKET -------- #}
    <div>
      <div class="col-head">МЕЖДУНАРОДНЫЙ РЫНОК</div>
      <div class="section-band">ДЕНЕЖНЫЙ РЫНОК</div>
      <div class="subgrid">
        <div>{% if bloomberg %}{% for curve in bloomberg.rate_curves %}{{ curve_table(curve) }}{% endfor %}{% endif %}</div>
        <div>
          {{ fx_table(bloomberg.fx, 'КУРСЫ ВАЛЮТ', 'Курс') if bloomberg }}
          {% if bloomberg %}{{ change_table(bloomberg.commodities.rows, 'СЫРЬЕВОЙ РЫНОК', 'Сырьё') }}{% endif %}
        </div>
      </div>
      <div class="section-band">РЫНОК КАПИТАЛА</div>
      <div class="subgrid">
        <div>
          {{ cap_table(cap.eurobonds_fx) }}
          {{ cap_table(cap.eurobonds_local) }}
        </div>
        <div>
          {% if bloomberg %}{{ change_table(bloomberg.equities.rows, 'ИНДЕКСЫ ФОНДОВОГО РЫНКА', 'Индекс') }}{% endif %}
          {% if bloomberg %}{{ treasury_table(bloomberg.treasuries) }}{% endif %}
          {% if L.show_charts %}
          <div class="chart-card"><img src="{{ charts.vix }}"/><div class="cap">VIX — индекс волатильности</div></div>
          <div class="chart-card"><img src="{{ charts.embi }}"/><div class="cap">EMBI — облигации развив. стран</div></div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

</body>
</html>
