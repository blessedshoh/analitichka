{% from "_macros.html.j2" import num, chg, fx_table, change_table, curve_table, uzonia_table, repo_table, interbank_table, treasury_table, stocks_table, summary_band with context %}
{#-
  NBU "ОБЗОР РЫНКА" newsletter — two A4-landscape pages, pixel-matched to the
  Canva reference. All colours derive from variables; the gold accent is
  defined ONCE as --accent-gold and referenced everywhere.
-#}
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8"/>
<style>
:root {
  --accent-gold: {{ accent_gold }};   /* caption / header-row / band fill */
  --page-bg: {{ page_bg }};
  --gold-line: #c6a667;                /* gold outlines: cards, oval, badge */
  --card-bg: #fbf8f1;                  /* opaque cream card */
  --ink: #161616;
  --muted: #8a7a5c;
  --grid: #c7c1b2;                     /* table cell borders (light gray) */
  --pill-line: #2c2c2c;
}
@page { size: A4 landscape; margin: 0; }
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: "DejaVu Sans", "PT Sans", "Noto Sans", Arial, sans-serif;
  color: var(--ink);
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}
.page {
  position: relative;
  width: 297mm; height: 210mm;
  background: var(--page-bg);
  overflow: hidden;
  page-break-after: always;
  padding: 5mm 6mm;
}
.page:last-child { page-break-after: auto; }

{% if background_placement == 'watermark' and background_uri %}
.page::before {
  content: ""; position: absolute; inset: 0;
  background-image: url('{{ background_uri }}');
  background-size: cover; background-position: center;
  opacity: {{ background_opacity }};
  filter: grayscale(0.4);
  pointer-events: none; z-index: 0;
}
{% endif %}
.page > * { position: relative; z-index: 1; }

/* ---------- Masthead ---------- */
.masthead {
  display: grid;
  grid-template-columns: 90px 1fr 300px;
  align-items: center;
  height: 66px;
  margin-bottom: 4px;
}
.logo-badge {
  width: 66px; height: 66px; border-radius: 50%;
  background: #fffdf8; border: 2px solid var(--gold-line);
  display: flex; align-items: center; justify-content: center;
}
.logo-badge img { height: 42px; }
.cartouche {
  justify-self: center;
  background: #fffdf8; border: 2px solid var(--gold-line);
  border-radius: 50% / 50%;
  padding: 8px 64px 12px;
  text-align: center; min-width: 360px;
}
.cartouche h1 {
  margin: 0; font-size: 30px; letter-spacing: 8px; font-weight: 800;
  color: #1c1c1c; font-family: "DejaVu Sans", Arial, sans-serif;
}
.cartouche .date {
  font-size: 12px; letter-spacing: 1px; color: #b08a3e; margin-top: 2px;
  font-family: "DejaVu Sans", Arial, sans-serif; font-weight: 700;
}
.dept {
  justify-self: end; align-self: start;
  background: #fffdf8; border: 1.5px solid var(--gold-line); border-radius: 10px;
  color: #1c1c1c; font-weight: 800; font-size: 13px; letter-spacing: .5px;
  text-align: center; padding: 9px 14px;
  font-family: "DejaVu Sans", Arial, sans-serif;
}

/* ---------- Page 1: news quadrants ---------- */
.quad-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 14px 16px;
  height: calc(210mm - 10mm - 66px - 8px);
  margin-top: 12px;
}
.quad {
  position: relative;
  background: var(--card-bg);
  border: 1.5px solid var(--gold-line);
  border-radius: 3px;
  padding: 16px 12px 8px;
}
.quad .pill {
  position: absolute; top: -15px; left: 50%; transform: translateX(-50%);
  background: #fffdf8; border: 1.5px solid var(--pill-line); border-radius: 12px;
  font-weight: 800; font-size: 17px; letter-spacing: 2px; color: #111;
  padding: 3px 30px; white-space: nowrap;
  font-family: "DejaVu Sans", Arial, sans-serif;
}
.quad .body {
  font-size: 9px; line-height: 1.3; text-align: justify; color: #141414;
  overflow: hidden; height: 100%;
}
.quad .body p { margin: 0 0 4px 0; }
.quad .body p.lead { font-weight: 800; }

/* ---------- Page 2 ---------- */
.col-head {
  text-align: center; font-weight: 800; font-size: 19px; letter-spacing: 2px;
  color: #111; padding: 0 0 3px; margin-bottom: 5px;
  border-bottom: 2px solid var(--gold-line);
  font-family: "DejaVu Sans", Arial, sans-serif;
}
.section-band {
  background: var(--accent-gold); color: #111;
  text-align: center; font-weight: 800; font-size: 12px; letter-spacing: 1px;
  padding: 2px 0; margin: 5px 0 4px;
  font-family: "DejaVu Sans", Arial, sans-serif;
}
.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.subgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; align-items: start; }

table.tbl {
  width: 100%; border-collapse: collapse; font-size: 7px;
  background: #fff; margin-bottom: 4px;
  border: 1px solid #8f8a7c;
  font-family: "DejaVu Sans", Arial, sans-serif;
}
table.tbl caption {
  background: var(--accent-gold); color: #111;
  font-weight: 800; font-size: 8px; padding: 2px; letter-spacing: .3px;
  border: 1px solid #8f8a7c; border-bottom: 0;
}
table.tbl th, table.tbl td {
  border: 1px solid var(--grid); padding: 1.4px 3px; text-align: right;
  white-space: nowrap;
}
table.tbl th {
  background: var(--accent-gold); color: #111; font-weight: 600;
  text-align: center;
}
table.tbl td.lbl { text-align: left; font-weight: 700; }
table.tbl th.lbl { text-align: left; font-weight: 600; }
tr.flagged td { background: #fff3c4 !important; }

.charts-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 5px 0; }
.chart-card { background: #fff; border: 1px solid #8f8a7c; padding: 3px; }
.chart-card img { width: 100%; height: auto; display: block; }
.chart-card .cap { font-size: 7px; color: #333; text-align: center; padding-top: 1px; font-family: "DejaVu Sans", Arial, sans-serif; }

.summary-band { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; margin: 5px 0; }
.summary-band .cell { background: var(--accent-gold); color: #111; padding: 4px 3px; text-align: center; border: 1px solid #8f8a7c; font-family: "DejaVu Sans", Arial, sans-serif; }
.summary-band .cell .k { font-size: 6.4px; line-height: 1.1; display: block; }
.summary-band .cell .v { font-size: 13px; font-weight: 800; }

.capnews { font-size: 7.6px; line-height: 1.3; text-align: justify; font-family: "DejaVu Sans", Arial, sans-serif; }
.capnews h4 { margin: 3px 0 2px; font-size: 8.5px; text-align: center; background: var(--accent-gold); padding: 2px; }
</style>
</head>
<body>

{# ===================== PAGE 1 — NEWS ===================== #}
<section class="page">
  <header class="masthead">
    <div class="logo-badge">{% if logo_uri %}<img src="{{ logo_uri }}"/>{% endif %}</div>
    <div class="cartouche">
      <h1>{{ meta.title }}</h1>
      <div class="date">{{ meta.weekday }} {{ meta.issue_date }}</div>
    </div>
    <div class="dept">{{ meta.department }}</div>
  </header>

  <div class="quad-grid">
    {% for key, label in [('us','США'), ('europe','ЕВРОПА'), ('asia','АЗИЯ'), ('cis','СНГ')] %}
    <div class="quad">
      <div class="pill">{{ label }}</div>
      <div class="body">
        {% for para in (news[key] or '').split('\n') if para.strip() %}
        <p class="{{ 'lead' if loop.first }}">{{ para }}</p>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>

{# ===================== PAGE 2 — DATA ===================== #}
<section class="page">
  <div class="two-col">
    {# -------- LEFT: LOCAL MARKET -------- #}
    <div>
      <div class="col-head">ЛОКАЛЬНЫЙ РЫНОК</div>
      <div class="section-band">ДЕНЕЖНЫЙ РЫНОК</div>

      <div class="subgrid">
        {{ fx_table(cbu_fx, 'КУРСЫ ВАЛЮТ', 'Курс') if cbu_fx }}
        {{ uzonia_table(money_market.uzonia) if money_market }}
      </div>

      <div class="subgrid">
        {{ interbank_table(money_market.interbank) if money_market }}
        {{ repo_table(money_market.repo) if money_market }}
      </div>

      {% if money_market %}{{ summary_band(money_market.summary) }}{% endif %}

      <div class="charts-row">
        <div class="chart-card">
          <img src="{{ charts.system_liquidity }}"/>
          <div class="cap">Общая ликвидность (итог корр. счетов в ЦБ)</div>
        </div>
        <div class="chart-card">
          <img src="{{ charts.cb_operations }}"/>
          <div class="cap">Операции ЦБ по привлечению ликвидности</div>
        </div>
      </div>

      <div class="section-band">РЫНОК КАПИТАЛА</div>
      {{ stocks_table(stocks) if stocks }}
      {% if news.capital_markets %}
      <div class="capnews">
        <h4>НОВОСТИ РЫНКА КАПИТАЛА</h4>
        {% for item in news.capital_markets %}<p>{{ item }}</p>{% endfor %}
      </div>
      {% endif %}
    </div>

    {# -------- RIGHT: INTERNATIONAL MARKET -------- #}
    <div>
      <div class="col-head">МЕЖДУНАРОДНЫЙ РЫНОК</div>
      <div class="section-band">ДЕНЕЖНЫЙ РЫНОК</div>

      <div class="subgrid">
        <div>
          {% if bloomberg %}{% for curve in bloomberg.rate_curves %}{{ curve_table(curve) }}{% endfor %}{% endif %}
        </div>
        <div>
          {{ fx_table(bloomberg.fx, 'КУРСЫ ВАЛЮТ', 'Курс') if bloomberg }}
          {% if bloomberg %}{{ change_table(bloomberg.commodities.rows, 'СЫРЬЕВОЙ РЫНОК', 'Сырьё') }}{% endif %}
        </div>
      </div>

      <div class="section-band">РЫНОК КАПИТАЛА</div>
      <div class="subgrid">
        {% if bloomberg %}{{ change_table(bloomberg.equities.rows, 'ИНДЕКСЫ ФОНДОВОГО РЫНКА', 'Индекс') }}{% endif %}
        {% if bloomberg %}{{ treasury_table(bloomberg.treasuries) }}{% endif %}
      </div>

      <div class="charts-row">
        <div class="chart-card"><img src="{{ charts.vix }}"/><div class="cap">VIX — индекс волатильности</div></div>
        <div class="chart-card"><img src="{{ charts.embi }}"/><div class="cap">EMBI — облигации развивающихся стран</div></div>
      </div>
    </div>
  </div>
</section>

</body>
</html>
