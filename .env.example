# ----------------------------------------------------------------------------
# NBU Newsletter Generator — environment configuration
# Copy to `.env` (repo root, read by the backend) and fill in as needed.
# Everything here has a safe default; the app runs without secrets, degrading
# gracefully (live fetchers fall back to manual entry).
# ----------------------------------------------------------------------------

# --- Brand / design ---------------------------------------------------------
# The single gold accent. Change here -> changes everywhere (CSS + charts UI).
ACCENT_GOLD=#f4e7d4
PAGE_BG=#faf4ea

# Background asset is referenced by PATH so you can swap the (transparent) PNG
# without touching code. Placement is one switch: watermark | cover | header | none
BACKGROUND_ASSET=./backend/assets/background.png
BACKGROUND_PLACEMENT=watermark
BACKGROUND_OPACITY=0.10
LOGO_ASSET=./backend/assets/nbu_logo.png

# --- CBU ---------------------------------------------------------------------
CBU_JSON_URL=https://cbu.uz/ru/arkhiv-kursov-valyut/json/
CBU_BASE_URL=https://cbu.uz
# CBU_CURRENCIES is a JSON list
CBU_CURRENCIES=["USD","EUR","RUB","CNY","GBP"]

# --- Bloomberg ---------------------------------------------------------------
BLOOMBERG_MAP_PATH=./backend/config/bloomberg_map.yaml

# --- Telegram (MTProto via Telethon) ----------------------------------------
# Create at https://my.telegram.org . Use a DEDICATED account, not the Bot API.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=./backend/config/tg.session
TELEGRAM_STOCK_CHANNEL=
# TELEGRAM_NEWS_CHANNELS is a JSON list, e.g. ["@channel1","@channel2"]
TELEGRAM_NEWS_CHANNELS=[]
# Map each news channel to a region so pulled posts pre-fill the right textbox.
# Regions: us | europe | asia | cis | capital_markets  (JSON object)
TELEGRAM_NEWS_CHANNEL_MAP={}
TELEGRAM_NEWS_PER_CHANNEL=5

# --- Morning auto-refresh scheduler -----------------------------------------
# When true, pre-warms the CBU rate cache daily at REFRESH_HOUR (local).
SCHEDULER_ENABLED=false
REFRESH_HOUR=7

# --- Anthropic (stock-table image extraction) -------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Validation --------------------------------------------------------------
CHANGE_PCT_TOLERANCE=0.05

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000
